# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key is intentionally absent. It bypasses Row Level
# Security, and every protection in this project rests on RLS
# (PRD 32). Server code uses the anon key plus the logged-in session.
